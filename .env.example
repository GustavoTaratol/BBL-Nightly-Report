# Copy this file to .env for local or TrueNAS deployment.
# Never commit .env or browser session data.

# America/Edmonton is the default league timezone.
BBL_TIMEZONE=America/Edmonton

# Remove /home; the collector appends CBS paths itself.
BBL_CBS_BASE_URL=https://bblbombasticbaketballleague.basketball.cbssports.com

# Delivery: leave both empty to archive only.
# Discord is the preferred first integration because it supports attachments.
# BBL_DISCORD_WEBHOOK_URL=
# BBL_PUBLISH_WEBHOOK_URL=

# Where generated reports and persistent snapshots are stored.
BBL_DATA_DIR=./data

# Optional: Discord webhook for automated delivery.
# BBL_DISCORD_WEBHOOK_URL=

# Optional: manager name highlighted as your team.
# BBL_MY_TEAM=
